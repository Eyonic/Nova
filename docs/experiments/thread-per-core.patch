+/// Start `per_core_threads` threads. Thread `i` serves socket `i` of every
+/// listener (socket 0 is `tcp`, the rest come from `extra`).
+fn spawn_per_core<H: Handler>(
+    listeners: Vec<Listener>,
+    shared: &Arc<Shared<H>>,
+    stop: &watch::Receiver<bool>,
+) -> std::io::Result<Vec<std::thread::JoinHandle<()>>> {
+    let n = shared.opts.per_core_threads;
+    let mut per_thread: Vec<Vec<(std::net::TcpListener, Option<TlsSettings>, bool)>> =
+        (0..n).map(|_| Vec::new()).collect();
+    for l in listeners {
+        let first = l.tcp.into_std()?;
+        for (i, sock) in std::iter::once(first).chain(l.extra).enumerate().take(n) {
+            per_thread[i].push((sock, l.tls.clone(), l.proxy_protocol));
+        }
+    }
+    let mut handles = Vec::new();
+    for (i, socks) in per_thread.into_iter().enumerate() {
+        let (shared, stop) = (Arc::clone(shared), stop.clone());
+        let rt = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .thread_name(format!("nova-http-{i}"))
+            .build()?;
+        handles.push(
+            std::thread::Builder::new()
+                .name(format!("nova-http-{i}"))
+                .spawn(move || {
+                    rt.block_on(async move {
+                        let graceful = GracefulShutdown::new();
+                        let listeners: Vec<Listener> = socks
+                            .into_iter()
+                            .filter_map(|(sock, tls, proxy_protocol)| {
+                                let tcp = TcpListener::from_std(sock)
+                                    .inspect_err(
+                                        |e| tracing::error!(error = %e, "per-core listener"),
+                                    )
+                                    .ok()?;
+                                Some(Listener {
+                                    tcp,
+                                    extra: Vec::new(),
+                                    tls,
+                                    proxy_protocol,
+                                })
+                            })
+                            .collect();
+                        futures_util::future::join_all(
+                            listeners
+                                .into_iter()
+                                .map(|l| accept_loop(l, &shared, &graceful, stop.clone())),
+                        )
+                        .await;
+                        let _ =
+                            tokio::time::timeout(shared.opts.shutdown_grace, graceful.shutdown())
+                                .await;
+                    });
+                })?,
+        );
+    }
+    Ok(handles)
+}
